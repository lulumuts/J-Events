# Copy to .env and fill in (never commit .env)

# --- Resend (https://resend.com) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender must use a domain verified in Resend (Domains → add DNS records)
# Example: "Jordan Graham <hello@yourdomain.com>"
CONTACT_FROM_EMAIL="Jordan Graham <hello@yourdomain.com>"

# Inbox that receives booking form submissions
CONTACT_TO_EMAIL=hello@yourdomain.com

# --- Frontend ---
# Local dev: leave unset — Vite proxies /api/contact to Express (port 8787)
#
# GitHub Pages (now): add repo secret VITE_CONTACT_API_URL pointing at your Vercel API
# VITE_CONTACT_API_URL=https://your-project.vercel.app/api/contact
#
# Vercel (later): leave unset — form uses same-origin /api/contact

# --- Local API server (optional) ---
# PORT=8787
