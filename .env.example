# Copy to .env and fill in (never commit .env)

# --- Resend (https://resend.com) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Local testing (no custom domain): Resend only allows this sender.
# It can deliver to the email on your Resend account, or to delivered@resend.dev.
# After you verify a domain: "Jordan Graham <hello@yourdomain.com>"
CONTACT_FROM_EMAIL="Acme <onboarding@resend.dev>"

# Inbox that receives booking form submissions.
# While using onboarding@resend.dev, this must be your Resend account email
# (or delivered@resend.dev to confirm the API without a real inbox).
CONTACT_TO_EMAIL=delivered@resend.dev

# Comma-separated browser origins allowed to POST /api/contact (GitHub Pages, production URL)
# Example: https://lulumuts.github.io,https://www.yourdomain.com
# Leave unset for local dev (any origin) or same-origin Vercel deploys
# CONTACT_ALLOWED_ORIGINS=

# --- Frontend ---
# Local dev: leave unset — Vite proxies /api/contact to Express (port 8787)
#
# GitHub Pages: static bookings are sent to VITE_BOOKING_INBOX (same address as CONTACT_TO_EMAIL).
# The first submission emails that inbox a one-time FormSubmit activation link.
# VITE_BOOKING_INBOX=you@example.com
# Later, when the API is hosted: repo secret VITE_CONTACT_API_URL=https://your-project.vercel.app/api/contact
#
# Vercel (later): leave unset — form uses same-origin /api/contact

# --- Local API server (optional) ---
# PORT=8787

# --- Sanity CMS (https://www.sanity.io/manage) ---
# Project ID from sanity.io/manage → your project → Project ID
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Seed script only (never expose in VITE_ — server / local CLI only)
# sanity.io/manage → API → Tokens → Add token (Editor)
# SANITY_API_TOKEN=sk...
# Optional aliases for seed:sanity (same values as above)
# SANITY_PROJECT_ID=
# SANITY_DATASET=
#
# If seed times out on large hero videos, retry after updates, or:
# SEED_SKIP_HERO_VIDEOS=true
#
# CORS (required for browser fetch — fixes “blocked by CORS policy” in dev/prod):
# sanity.io/manage → your project → API → CORS origins → Add origin
#   http://localhost:5173          (and 5174, 5175… if Vite picks another port)
#   https://your-production-domain.com
# No trailing slash. Enable “authenticated requests” for origins that host /studio.
# Local dev: Vite proxies /sanity-cdn so CMS fetch works on any port; production still needs CORS.

# --- Publish → redeploy (Vercel serverless env, not VITE_) ---
# Create Deploy Hook: Vercel project → Settings → Git → Deploy Hooks
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
#
# Sanity webhook: sanity.io/manage → API → Webhooks → create on Publish
# URL: https://your-domain.vercel.app/api/sanity-webhook
# Header: x-sanity-webhook-secret: (same value as below)
# SANITY_WEBHOOK_SECRET=generate_a_long_random_string
